{{- if not (empty $table) }}
  {{- $allOfTable = true }}
  {{- range .Columns }}
    {{- if eq .Table nil }}
      {{- $allOfTable = false }}
    {{- else if not (and (eq $table.Name .Table.Name) (eq $table.Schema .Table.Schema)) }}
      {{- $allOfTable = false }}
    {{- end }}
  {{- end }}
{{- end }}
{{- $prefix := "" }}
