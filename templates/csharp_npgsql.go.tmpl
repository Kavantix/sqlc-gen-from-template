namespace {{ getPluginOption "namespace" }};

// ---------- Models ----------
{{- range .Catalog.Schemas }}
{{- if or (or (eq .Name "pg_temp") (eq .Name "pg_catalog")) (eq .Name "information_schema")}}
{{- else }}

// Schema: {{ .Name }}
{{- $prefix := "" }}
{{- if not (eq .Name $defaultSchema) }}
{{- $prefix = printf "%s_" .Name }}
{{- end -}}

{{- range .CompositeTypes }}
{{- $sqlName := printf "%s%s" $prefix .Name }}
{{- $name := $sqlName | snakeToCamelCase | toPascalCase}}
{{- $_ := set $customTypes $sqlName $name }}
